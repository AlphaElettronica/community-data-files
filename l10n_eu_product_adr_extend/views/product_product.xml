<odoo>
    <data>

        <record model="ir.ui.view" id="product_normal_form_view_extend_adr">
            <field name="name">product_normal_form_view_extend_adr</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="l10n_eu_product_adr.product_normal_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='storage']" position="after">
                    <group name="full_class_name" string="Full Class Name">
                        <field name="full_class_name" readonly="1" force_save="1"/>
                    </group>
                </xpath>
                <xpath expr="//group[@name='main_dangerous_info']" position="inside">
                    <field name="special_disposition_id"/>
                    <field name="not_subjected_to_adr"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>